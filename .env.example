# ── Environment Variables — web-sopify (Streamlit UI) ─────────────────────────

# URL backend API (Cloud Run service URL)
# contoh: https://sopify-api-xxxx-as.a.run.app
API_URL="https://sopify-api-xxxx-as.a.run.app"

# JWT token untuk autentikasi ke backend API
# dapatkan dari POST /api/v1/auth/login → data.access_token
API_TOKEN="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
